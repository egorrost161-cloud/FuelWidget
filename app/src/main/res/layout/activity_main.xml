<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Топливо"
            android:textSize="28sp"
            android:textColor="@color/text_black"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <!-- БЛОК 1: РАЗРЕШЕНИЯ -->
        <LinearLayout
            android:id="@+id/layout_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Для работы нужны разрешения. Нажми на каждое."
                android:textSize="14sp"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="12dp" />

            <!-- CAR INFO ТЕПЕРЬ ПЕРВЫЙ -->
            <Button
                android:id="@+id/btn_perm_carinfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Доступ к данным авто (CAR_INFO)"
                android:backgroundTint="@color/btn_gray"
                android:textColor="@color/text_black"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_perm_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Статистика использования"
                android:backgroundTint="@color/btn_gray"
                android:textColor="@color/text_black"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_perm_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Наложение поверх окон"
                android:backgroundTint="@color/btn_gray"
                android:textColor="@color/text_black"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ПРОДОЛЖИТЬ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/btn_green" />
        </LinearLayout>

        <!-- БЛОК 2: НАСТРОЙКИ -->
        <LinearLayout
            android:id="@+id/layout_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Размер окна" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn_window_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_window_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="42 dp" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_window_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Размер шрифта" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn_font_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_font_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="16 sp" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_font_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Размер иконки" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn_icon_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_icon_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="20 dp" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_icon_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Толщина шрифта" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn_weight_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_font_weight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="400" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_weight_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Тема текста" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                <Button android:id="@+id/btn_theme_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="◀" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_theme" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Авто" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_theme_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="▶" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Блокировка виджета" android:textSize="14sp" android:textColor="@color/text_gray" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/btn_lock_minus" android:layout_width="48dp" android:layout_height="48dp" android:text="◀" android:backgroundTint="@color/btn_gray"/>
                <TextView android:id="@+id/txt_lock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Разблокирован" android:textSize="18sp" android:textColor="@color/text_black"/>
                <Button android:id="@+id/btn_lock_plus" android:layout_width="48dp" android:layout_height="48dp" android:text="▶" android:backgroundTint="@color/btn_gray"/>
            </LinearLayout>

        </LinearLayout>

        <!-- БЛОК 3: КНОПКИ ДЕЙСТВИЙ -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_app_list"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="СКРЫТЬ В ПРИЛОЖЕНИЯХ"
                android:backgroundTint="@color/btn_gray"
                android:textColor="@color/text_black"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="СБРОСИТЬ НАСТРОЙКИ"
                android:backgroundTint="@color/btn_red"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
