<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки Топливо"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="24dp" />

        <!-- ... (все блоки настроек размера, шрифта, иконки, темы, блокировки остаются без изменений) ... -->
        <!-- Для краткости я не дублирую их здесь, они остаются как были. -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Размер окна"
            android:textSize="16sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_window_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−" />
            <TextView
                android:id="@+id/txt_window_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="42 dp" />
            <Button
                android:id="@+id/btn_window_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Размер шрифта"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_font_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−" />
            <TextView
                android:id="@+id/txt_font_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="16 sp" />
            <Button
                android:id="@+id/btn_font_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Размер иконки"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_icon_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−" />
            <TextView
                android:id="@+id/txt_icon_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="20 dp" />
            <Button
                android:id="@+id/btn_icon_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Толщина шрифта"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_weight_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="−" />
            <TextView
                android:id="@+id/txt_font_weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="400" />
            <Button
                android:id="@+id/btn_weight_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тема текста"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_theme_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="◀" />
            <TextView
                android:id="@+id/txt_theme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Авто" />
            <Button
                android:id="@+id/btn_theme_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="▶" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Блокировка виджета"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_lock_minus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="◀" />
            <TextView
                android:id="@+id/txt_lock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Разблокирован" />
            <Button
                android:id="@+id/btn_lock_plus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="▶" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_app_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Выбрать приложения для скрытия"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Сбросить настройки"
            android:backgroundTint="#E53935" />

        <!-- НОВАЯ КНОПКА ДЛЯ ТЕСТА РУЛЯ -->
        <Button
            android:id="@+id/btn_test_wheel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ТЕСТ: Угол руля"
            android:textSize="16sp"
            android:backgroundTint="#FF9800" />

    </LinearLayout>
</ScrollView>
